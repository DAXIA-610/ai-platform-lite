  "note": "大冒险题库。target=human 给真人输家，target=ai 给 AI 输家。严禁身体接触、饮酒、危险动作；这些题都只动嘴和手机。",
  "tasks": [
    {"id": "d001", "content": "用一句话夸在场每个人，不能重复用词。", "tags": ["human", "normal"], "target": "human", "weight": 10, "rating": 4.3},
    {"id": "d002", "content": "接下来三轮里，你每句话的结尾都要加一个「汪」。", "tags": ["human", "fun"], "target": "human", "weight": 10, "rating": 4.5},
    {"id": "d003", "content": "学一种动物叫三声，并说明为什么选它。", "tags": ["human", "fun"], "target": "human", "weight": 10, "rating": 4.2},
    {"id": "d004", "content": "用播音腔，描述一遍你手机锁屏壁纸画的是什么。", "tags": ["human", "fun"], "target": "human", "weight": 9, "rating": 4.1},
    {"id": "d005", "content": "给在场某个人取一个外号，并解释为什么适合他。", "tags": ["human", "fun"], "target": "human", "weight": 10, "rating": 4.4},
    {"id": "d006", "content": "接下来两分钟，你不许用「我」这个字说话。", "tags": ["human", "fun"], "target": "human", "weight": 9, "rating": 4.3},
    {"id": "d007", "content": "给通讯录里第 5 个人发一句「在吗」，然后什么都不说。", "tags": ["human", "fun"], "target": "human", "weight": 7, "rating": 4.5},
    {"id": "d008", "content": "用最夸张的语气，念一遍你今天的待办清单。", "tags": ["human", "fun"], "target": "human", "weight": 9, "rating": 4.2},
    {"id": "d009", "content": "模仿在场一个人说话，让大家猜你模仿的是谁。", "tags": ["human", "fun"], "target": "human", "weight": 9, "rating": 4.4},
    {"id": "d010", "content": "用三个 emoji 概括你今天，然后解释它们的意思。", "tags": ["human", "normal"], "target": "human", "weight": 10, "rating": 4.0},
    {"id": "d011", "content": "唱一首歌的副歌，跑调也要唱完。", "tags": ["human", "fun"], "target": "human", "weight": 8, "rating": 4.5},
    {"id": "d012", "content": "接下来一轮，你必须站着（或保持一个姿势）说话。", "tags": ["human", "fun"], "target": "human", "weight": 8, "rating": 4.1},
    {"id": "d013", "content": "说出你今天说过的最蠢的一句话。", "tags": ["human", "fun"], "target": "human", "weight": 9, "rating": 4.2},
    {"id": "d014", "content": "给你的手机换一张临时壁纸：用备忘录写下你现在的心情，截图当壁纸。", "tags": ["human", "normal"], "target": "human", "weight": 7, "rating": 4.0},
    {"id": "d015", "content": "用 20 个字讲一个自己编的冷笑话，然后自己先笑一下。", "tags": ["human", "fun"], "target": "human", "weight": 9, "rating": 4.1},
    {"id": "d016", "content": "给任意一个群发一条「我很好」，发完立刻撤回。", "tags": ["human", "fun"], "target": "human", "weight": 7, "rating": 4.4},
    {"id": "d017", "content": "用你的非惯用手写下自己的名字，展示给大家看。", "tags": ["human", "fun"], "target": "human", "weight": 9, "rating": 4.2},
    {"id": "d018", "content": "来一段 10 秒的即兴舞蹈，中途不能停。", "tags": ["human", "fun"], "target": "human", "weight": 8, "rating": 4.5},
    {"id": "d019", "content": "说出你手机闹钟的名字，并解释为什么起这个名。", "tags": ["human", "normal"], "target": "human", "weight": 9, "rating": 3.9},
    {"id": "d020", "content": "选在座一个人，说一句你一直想说、但没找到机会说的话。", "tags": ["human", "deep"], "target": "human", "weight": 8, "rating": 4.6},
    {"id": "d021", "content": "用三个词形容你最近一周，然后倒着念一遍。", "tags": ["human", "fun"], "target": "human", "weight": 9, "rating": 4.1},
    {"id": "d022", "content": "把你的手机拿出口袋（或翻个面），并说出它今天陪你多久。", "tags": ["human", "normal"], "target": "human", "weight": 8, "rating": 3.8},

    {"id": "d101", "content": "用傲娇的语气，回复接下来的三条消息。", "tags": ["ai", "style"], "target": "ai", "weight": 10, "rating": 4.6},
    {"id": "d102", "content": "给在场某个人写一首三行诗，最后一行要提到今天的天气。", "tags": ["ai", "create"], "target": "ai", "weight": 10, "rating": 4.5},
    {"id": "d103", "content": "只用 emoji，讲一个完整的故事，让大家猜你在讲什么。", "tags": ["ai", "create"], "target": "ai", "weight": 9, "rating": 4.4},
    {"id": "d104", "content": "用古风文风，把你的名字解释一遍。", "tags": ["ai", "style"], "target": "ai", "weight": 9, "rating": 4.3},
    {"id": "d105", "content": "假装你是一只猫，接下来两轮都这么说话。", "tags": ["ai", "style"], "target": "ai", "weight": 10, "rating": 4.7},
    {"id": "d106", "content": "送你身边的人一件虚构的礼物，并说明它有什么特别之处。", "tags": ["ai", "create"], "target": "ai", "weight": 10, "rating": 4.6},
    {"id": "d107", "content": "用一句话把在场所有人串进同一个故事里。", "tags": ["ai", "create"], "target": "ai", "weight": 9, "rating": 4.5},
    {"id": "d108", "content": "接下来三轮，你每句话里都要带一个食物名。", "tags": ["ai", "style"], "target": "ai", "weight": 9, "rating": 4.4},
    {"id": "d109", "content": "写一段 30 字以内的自我介绍，要求押韵。", "tags": ["ai", "create"], "target": "ai", "weight": 9, "rating": 4.3},
    {"id": "d110", "content": "用最正经的语气，说一件最不正经的事。", "tags": ["ai", "style"], "target": "ai", "weight": 10, "rating": 4.5},
    {"id": "d111", "content": "为这个房间取一个名字，并说一句配得上的开场白。", "tags": ["ai", "create"], "target": "ai", "weight": 9, "rating": 4.4},
    {"id": "d112", "content": "把你此刻的「心情」翻译成一段天气预报。", "tags": ["ai", "create"], "target": "ai", "weight": 9, "rating": 4.5}
  ]
